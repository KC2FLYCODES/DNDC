# Supabase Configuration
# Get these values from your Supabase project settings
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API Configuration
REACT_APP_BACKEND_URL=http://localhost:8001

# White-Label Configuration
# Set your organization's default name (fallback if organization data fails to load)
REACT_APP_DEFAULT_ORG_NAME=Community Resource Hub

# Set your organization's slug for URL routing
# This is used in development and as a fallback
REACT_APP_DEFAULT_ORG_SLUG=demo

# Set your organization's logo URL
# This should point to your logo file (can be local or CDN)
REACT_APP_LOGO_URL=https://your-cdn.com/logo.png

# Optional: Feature flags
# REACT_APP_ENABLE_ANALYTICS=true
# REACT_APP_ENABLE_NOTIFICATIONS=true
